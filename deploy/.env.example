# =====================================================================
# Variables de entorno del despliegue de SACE
# ---------------------------------------------------------------------
# Copia este archivo como 'deploy/.env' y cambia los valores:
#
#   cp deploy/.env.example deploy/.env
#
# 'deploy/.env' NO se versiona (esta en el .gitignore del repositorio).
# Este archivo (.env.example) si se versiona, para que quede la plantilla
# de que necesita el sistema.
#
# ---------------------------------------------------------------------
# COMO GENERAR UN SECRETO
#   En Linux/macOS :  openssl rand -base64 48
#   En Windows     :  powershell -c "[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))"
# =====================================================================


# ---------------------------------------------------------------
# BASE DE DATOS POSTGRESQL
# ---------------------------------------------------------------
# Solo para Docker Compose / servidor propio. En Render, Railway o Fly
# los Defines estos tres datos en el panel de la plataforma.
POSTGRES_DB=SACE_db
POSTGRES_USER=sac_user
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA_DE_POSTGRES


# ---------------------------------------------------------------
# SEGURIDAD
# ---------------------------------------------------------------
# Firma de los tokens de sesion (HMAC). Si cambia, se invalidan todas
# las sesiones abiertas: es lo que se usa para "cerrar la puerta".
SACE_TOKEN_SECRET=CAMBIAR_ESTE_SECRETO_ALEATORIO_DE_48_BYTES

# Contrasena del administrador semilla (admin@aleleotours.com).
# El seed la crea con este valor y la rota en cada arranque, asi que
# cambiar la variable y reiniciar ya basta para rotarla.
SACE_ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA_DEL_ADMINISTRADOR

# Horas de validez del token de sesion.
SACE_TOKEN_HORAS=24


# ---------------------------------------------------------------
# CORS: dominios del frontend que pueden llamar la API
# ---------------------------------------------------------------
# Lista separada por comas. Debe incluir el sitio real: el dominio
# propio y (si usas Cloudflare Pages) el subdominio .pages.dev.
SACE_CORS_ORIGINS=https://aleleotours.com,https://www.aleleotours.com,https://aleleotours.pages.dev


# ---------------------------------------------------------------
# AJUSTES DE SPRING
# ---------------------------------------------------------------
# Ruta ABSOLUTA de los comprobantes PDF. En Docker Compose es un
# volumen persistente; en Render con disco, /var/data/comprobantes.
SACE_UPLOAD_DIR=/app/uploads/comprobantes

# false en produccion (no vuelca SQL en el log).
SACE_SHOW_SQL=false

# update crea las tablas que falten al arrancar (necesario en el
# primer despliegue). Cuando el esquema este estable: none.
SACE_DDL_AUTO=update

# Tamano del pool de conexiones de Hikari.
SACE_DB_POOL_SIZE=10
SACE_DB_POOL_MIN=2


# ---------------------------------------------------------------
# PASARELA DE PAGOS
# ---------------------------------------------------------------
# mock = pasarela simulada (sin internet, ideal para la demo).
# wompi = pasarela real. Las llaves de abajo son de SANDBOX.
PAGOS_PASARELA=mock
PAGOS_METODOS=PSE,TARJETA

WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/l/
WOMPI_PUB_KEY=
WOMPI_PRV_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_SECRET=


# ---------------------------------------------------------------
# CORREO (notificaciones). Opcional: el servicio tiene fail-safe.
# ---------------------------------------------------------------
PROPIETARIO_EMAIL=propietario@aleleotours.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
